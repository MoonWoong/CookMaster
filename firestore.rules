rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidIngredient(data) {
      return data.keys().hasAll(['id', 'name', 'expiryDate', 'status', 'userId'])
        && data.keys().hasOnly(['id', 'name', 'expiryDate', 'status', 'itemType', 'dateManageType', 'registeredDate', 'category', 'quantity', 'imageUrl', 'userId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.expiryDate is string && data.expiryDate.size() <= 30
        && data.status in ['fresh', 'warning', 'expired']
        && data.userId is string && data.userId.size() <= 128
        && (!('itemType' in data) || (data.itemType in ['ingredient', 'side_dish']))
        && (!('dateManageType' in data) || (data.dateManageType in ['expiry', 'registered']))
        && (!('registeredDate' in data) || (data.registeredDate is string && data.registeredDate.size() <= 30))
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('quantity' in data) || (data.quantity is string && data.quantity.size() <= 50))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 100000));
    }

    function isOwner(userId) {
      return !isSignedIn() || userId == request.auth.uid || userId.matches('^(guest|user).*$');
    }

    match /ingredients/{ingredientId} {
      allow get: if isValidId(ingredientId) && isOwner(resource.data.userId);
      allow list: if !isSignedIn() || resource.data.userId == request.auth.uid || resource.data.userId.matches('^(guest|user).*$');
      allow create: if isValidId(ingredientId)
        && isValidIngredient(incoming())
        && isOwner(incoming().userId);
      allow update: if isValidId(ingredientId)
        && isValidIngredient(incoming())
        && isOwner(existing().userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'expiryDate', 'status', 'itemType', 'dateManageType', 'registeredDate', 'category', 'quantity', 'imageUrl', 'updatedAt']);
      allow delete: if isValidId(ingredientId) && isOwner(existing().userId);
    }

    function isValidFavoriteRecipe(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'ingredients', 'steps'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.ingredients is list
        && data.steps is list;
    }

    match /favorite_recipes/{recipeId} {
      allow get: if isValidId(recipeId) && isOwner(resource.data.userId);
      allow list: if !isSignedIn() || resource.data.userId == request.auth.uid || resource.data.userId.matches('^(guest|user).*$');
      allow create: if isValidId(recipeId)
        && isValidFavoriteRecipe(incoming())
        && isOwner(incoming().userId);
      allow update: if isValidId(recipeId)
        && isValidFavoriteRecipe(incoming())
        && isOwner(existing().userId);
      allow delete: if isValidId(recipeId) && isOwner(existing().userId);
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['id', 'passwordHash', 'nickname'])
        && data.keys().hasOnly(['id', 'passwordHash', 'nickname', 'createdAt'])
        && data.id is string && data.id.size() <= 100
        && data.passwordHash is string && data.passwordHash.size() <= 200
        && data.nickname is string && data.nickname.size() <= 50;
    }

    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isValidUserAccount(incoming());
      allow update: if isValidId(userId) && isValidUserAccount(incoming());
      allow delete: if isValidId(userId);
    }

    function isValidCartItem(data) {
      return data.keys().hasAll(['id', 'userId', 'item'])
        && data.keys().hasOnly(['id', 'userId', 'item', 'reason', 'checked', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.item is string && data.item.size() <= 200
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 200))
        && (!('checked' in data) || data.checked is bool);
    }

    match /cart_items/{itemId} {
      allow get: if isValidId(itemId) && isOwner(resource.data.userId);
      allow list: if !isSignedIn() || resource.data.userId == request.auth.uid || resource.data.userId.matches('^(guest|user).*$');
      allow create: if isValidId(itemId) && isValidCartItem(incoming()) && isOwner(incoming().userId);
      allow update: if isValidId(itemId) && isValidCartItem(incoming()) && isOwner(existing().userId);
      allow delete: if isValidId(itemId) && isOwner(existing().userId);
    }

    function isValidNotificationSetting(data) {
      return data.keys().hasAll(['id', 'userId', 'enabled', 'time'])
        && data.keys().hasOnly(['id', 'userId', 'enabled', 'time', 'lastNotifiedDate', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.enabled is bool
        && data.time is string && data.time.size() <= 10
        && (!('lastNotifiedDate' in data) || (data.lastNotifiedDate is string && data.lastNotifiedDate.size() <= 30))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /notification_settings/{settingId} {
      allow get: if isValidId(settingId) && isOwner(resource.data.userId);
      allow list: if !isSignedIn() || resource.data.userId == request.auth.uid || resource.data.userId.matches('^(guest|user).*$');
      allow create: if isValidId(settingId) && isValidNotificationSetting(incoming()) && isOwner(incoming().userId);
      allow update: if isValidId(settingId) && isValidNotificationSetting(incoming()) && isOwner(existing().userId);
      allow delete: if isValidId(settingId) && isOwner(existing().userId);
    }
  }
}
