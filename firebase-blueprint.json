{
  "entities": {
    "Ingredient": {
      "title": "Ingredient",
      "description": "A food ingredient item stored in the refrigerator",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the ingredient"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the food ingredient"
        },
        "expiryDate": {
          "type": "string",
          "maxLength": 30,
          "description": "Expiry date or D-day indicator string"
        },
        "status": {
          "type": "string",
          "enum": ["fresh", "warning", "expired"],
          "description": "Freshness status calculated or specified"
        },
        "itemType": {
          "type": "string",
          "enum": ["ingredient", "side_dish"],
          "description": "Classification whether item is a cooking ingredient (식재료) or a prepared side dish (반찬)"
        },
        "category": {
          "type": "string",
          "maxLength": 50,
          "description": "Category such as vegetable, meat, dairy, etc."
        },
        "quantity": {
          "type": "string",
          "maxLength": 50,
          "description": "Quantity or volume of the ingredient"
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 100000,
          "description": "Stylized illustrative image URL generated by Imagen or placeholder"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of the user who owns this ingredient"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "name", "expiryDate", "status", "userId"]
    },
    "FavoriteRecipe": {
      "title": "FavoriteRecipe",
      "description": "A bookmarked chef recipe saved by the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the favorite recipe"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "User identifier who saved the recipe"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Recipe title"
        },
        "recipeType": {
          "type": "string",
          "enum": ["urgent", "alternative", "expansion", "custom"],
          "description": "Category or type of recipe"
        },
        "ingredients": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of required ingredients"
        },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Step-by-step cooking directions"
        },
        "usedExpiringIngredients": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of urgent ingredients rescued"
        },
        "missingIngredientsToBuy": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of missing ingredients"
        },
        "briefSteps": {
          "type": "string",
          "description": "Brief description of the recipe steps"
        },
        "chefTip": {
          "type": "string",
          "description": "Chef tip for cooking"
        },
        "estimatedTimeMinutes": {
          "type": "number",
          "description": "Estimated cooking time in minutes"
        },
        "difficulty": {
          "type": "string",
          "description": "Cooking difficulty"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "title", "ingredients", "steps"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "User account credentials and profile for cross-device synchronization",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "description": "Account login ID"
        },
        "passwordHash": {
          "type": "string",
          "maxLength": 200,
          "description": "Password hash or token"
        },
        "nickname": {
          "type": "string",
          "maxLength": 50,
          "description": "User display nickname"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        }
      },
      "required": ["id", "passwordHash", "nickname"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "A shopping cart item synchronized across devices",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique identifier of the cart item"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Owner user ID"
        },
        "item": {
          "type": "string",
          "maxLength": 200,
          "description": "Item name to purchase"
        },
        "reason": {
          "type": "string",
          "maxLength": 200,
          "description": "Reason for purchase or recipe note"
        },
        "checked": {
          "type": "boolean",
          "description": "Check status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "item"]
    }
  },
  "firestore": {
    "/ingredients/{ingredientId}": {
      "schema": {
        "$ref": "#/entities/Ingredient"
      },
      "description": "Collection of refrigerator ingredients"
    },
    "/favorite_recipes/{recipeId}": {
      "schema": {
        "$ref": "#/entities/FavoriteRecipe"
      },
      "description": "Collection of favorite recipes saved by users"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Collection of user accounts for cross-device login"
    },
    "/cart_items/{itemId}": {
      "schema": {
        "$ref": "#/entities/CartItem"
      },
      "description": "Collection of shopping cart items synchronized across devices"
    }
  }
}
